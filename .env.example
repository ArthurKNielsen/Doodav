# Doohickey settings. Copy to .env and edit. Nothing here is required for barcode scans.

# AI provider for object scans and follow-up questions.
#   ollama  (default) free, runs on your own computer, no account or key
#   gemini  free tier from Google, needs a free API key
AI_PROVIDER=ollama

# --- Ollama (default) ---
# Install from https://ollama.com, then: ollama pull qwen2.5vl:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# --- Gemini (optional) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# API server port (default 8787)
# PORT=8787
